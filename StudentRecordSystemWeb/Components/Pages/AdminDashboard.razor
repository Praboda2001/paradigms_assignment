@* Admin dashboard: ranked table of student records with a WAM bar, search, add, edit, remove and parallel WAM recalculation. *@
@page "/admin"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using StudentRecordSystem.Exceptions
@using StudentRecordSystem.Models
@using StudentRecordSystem.Services
@inject RecordManager RecordManager
@inject SessionService Session
@inject NavigationManager Nav
@* IJSRuntime lets C# call the browser's built-in confirm dialog. *@
@inject IJSRuntime JS
@* IDisposable lets the page clean up (unsubscribe from the event) when it closes. *@
@implements IDisposable

<PageTitle>Admin Dashboard</PageTitle>

@* Nothing is shown to anyone who is not an admin. *@
@if (!isAuthorised)
{
    <p>Redirecting...</p>
}
else
{
    <h1>Welcome, @(Session.CurrentUser?.Username) (@(Session.CurrentUser?.GetRoleDescription()))</h1>

    <input @bind="searchId" placeholder="Search by Student ID" />
    <button @onclick="Search">Search</button>
    <button @onclick="ShowAll">Show All</button>
    <button @onclick="GoToAdd">Add Student</button>
    <button @onclick="RecalculateAll">Recalculate All WAM</button>
    <button @onclick="Logout">Log Out</button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red">@errorMessage</p>
    }

    <table border="1" cellpadding="6" style="margin-top:12px;">
        <thead>
            <tr><th>Rank</th><th>Student ID</th><th>Name</th><th>Program</th><th>WAM</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @* foreach builds one table row for each student record. *@
            @foreach (var record in records)
            {
                <tr>
                    @* The rank comes from the dictionary built by CalculateRanks. *@
                    <td>@ranks.GetValueOrDefault(record.Id)</td>
                    <td>@record.StudentID</td>
                    <td>@record.Name</td>
                    <td>@record.Program</td>
                    <td>
                        @record.Wam.ToString("F2")
                        @* WAM bar: the inner bar's width is the WAM as a percentage.
                           Math.Clamp keeps it between 0 and 100 and (int) is an explicit cast. *@
                        <div style="background:#e0e0e0; width:120px; height:8px; border-radius:4px;">
                            <div style="background:#2b579a; width:@((int)Math.Clamp(record.Wam, 0, 100))%; height:8px; border-radius:4px;"></div>
                        </div>
                    </td>
                    <td>@record.Status</td>
                    <td>
                        @* The lambdas pass this row's values to the handlers. *@
                        <button @onclick="() => GoToEdit(record.Id)">Edit</button>
                        <button @onclick="() => Remove(record.StudentID)">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<StudentRecord> records = new();
    // Maps each record's Id to its class rank.
    private Dictionary<int, int> ranks = new();
    private string searchId = string.Empty;
    private string? errorMessage;
    private bool isAuthorised;

    protected override async Task OnInitializedAsync()
    {
        // Only admins get past this point.
        if (Session.CurrentUser is not Admin)
        {
            Nav.NavigateTo("/");
            return;
        }
        isAuthorised = true;

        // Subscribe to the event so the list refreshes when a record is added.
        RecordManager.RecordAdded += OnRecordAdded;
        await LoadAll();
    }

    // This is the event handler. Events return void, so the work is handed to
    // InvokeAsync, which runs it on the page's own thread and then redraws.
    private void OnRecordAdded(object? sender, StudentRecord record)
    {
        InvokeAsync(async () =>
        {
            await LoadAll();
            StateHasChanged();
        });
    }

    // This loads every record and works out the ranks.
    private async Task LoadAll()
    {
        records = await RecordManager.GetAllRecordsAsync();
        // Ranks always come from the full list, so a search result still
        // shows the student's real class rank.
        ranks = RecordManager.CalculateRanks(records);
    }

    private async Task Search()
    {
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(searchId))
        {
            await LoadAll();
            return;
        }
        try
        {
            var record = await RecordManager.SearchRecordAsync(searchId.Trim());
            records = new List<StudentRecord> { record };
        }
        catch (StudentNotFoundException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task ShowAll()
    {
        searchId = string.Empty;
        errorMessage = null;
        await LoadAll();
    }

    // These short methods use => because their body is one expression.
    private void GoToAdd() => Nav.NavigateTo("/admin/edit");

    private void GoToEdit(int id) => Nav.NavigateTo($"/admin/edit/{id}");

    private async Task Remove(string studentId)
    {
        // Ask first so a record is never deleted by an accidental click.
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove student {studentId}? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        try
        {
            await RecordManager.RemoveRecordAsync(studentId);
            await LoadAll();
        }
        catch (StudentNotFoundException ex)
        {
            errorMessage = ex.Message;
        }
    }

    // This runs the parallel WAM recalculation and then refreshes the table.
    private async Task RecalculateAll()
    {
        await RecordManager.RecalculateAllWamAsync();
        await LoadAll();
    }

    private void Logout()
    {
        Session.CurrentUser = null;
        Nav.NavigateTo("/");
    }

    // Unsubscribe when the page closes so old handlers do not pile up.
    public void Dispose()
    {
        RecordManager.RecordAdded -= OnRecordAdded;
    }
}
