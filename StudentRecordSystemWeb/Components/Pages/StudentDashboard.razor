@* Student dashboard: read-only view of the signed-in student's own record and units. *@
@page "/student"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using StudentRecordSystem.Models
@using StudentRecordSystem.Services
@inject RecordManager RecordManager
@inject SessionService Session
@inject NavigationManager Nav

<PageTitle>My Record</PageTitle>

@* record is null until the database call in OnInitializedAsync finishes. *@
@if (record is null)
{
    <p>Loading...</p>
}
else
{
    <h1>@record.Name</h1>
    <p>@record.Program</p>
    <p>Status: @record.Status</p>

    @* ToString("F2") shows the WAM with two decimal places. *@
    <p><strong>Weighted Average Mark: @record.Wam.ToString("F2")</strong></p>

    <h2>Enrolled Units</h2>
    <table border="1" cellpadding="6">
        <thead>
            <tr><th>Code</th><th>Unit</th><th>Semester</th><th>Grade</th><th>Mark</th></tr>
        </thead>
        <tbody>
            @* foreach builds one table row for each unit. *@
            @foreach (var unit in record.Units)
            {
                <tr>
                    <td>@unit.UnitCode</td>
                    <td>@unit.UnitName</td>
                    <td>@unit.Semester</td>
                    <td>@unit.Grade</td>
                    <td>@unit.Mark.ToString("F1")</td>
                </tr>
            }
        </tbody>
    </table>

    <button @onclick="Logout" style="margin-top:12px;">Log Out</button>
}

@code {
    // StudentRecord? is nullable because the record is not loaded yet.
    private StudentRecord? record;

    protected override async Task OnInitializedAsync()
    {
        // Only students get past this point. The pattern "is not Student student"
        // also creates the variable student when the check passes.
        if (Session.CurrentUser is not Student student)
        {
            Nav.NavigateTo("/");
            return;
        }

        // A student can only ever load the record linked to their own account.
        record = await RecordManager.TryGetByIdAsync(student.StudentRecordId);
    }

    private void Logout()
    {
        Session.CurrentUser = null;
        Nav.NavigateTo("/");
    }
}
